{
  "name": "@riddance/deploy",
  "version": "0.2.1",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/movogo-io/node-deploy.git"
  },
  "keywords": [
    "riddance",
    "environment",
    "devops",
    "opinionated",
    "aws",
    "lambda"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "*.js",
    "bin/*.js",
    "lib/*.js",
    "lib/aws/*.js",
    "lib/aws/services/*.js"
  ],
  "bin": {
    "deploy": "bin/index.js"
  },
  "dependencies": {
    "@riddance/host": "0.3.1",
    "@riddance/fetch": "0.1.5",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-virtual": "3.0.2",
    "@rollup/wasm-node": "4.62.4",
    "@smithy/signature-v4": "5.6.12",
    "jszip": "3.10.1",
    "terser": "5.49.2"
  },
  "scripts": {
    "prepack": "riddance-build",
    "start": "riddance-watch",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  },
  "devDependencies": {
    "@riddance/env": "0.10.2"
  },
  "allowScripts": {
    "@riddance/env": true
  }
}
